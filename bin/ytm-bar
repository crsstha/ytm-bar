#!/usr/bin/env python3
"""YouTube Music in the desktop bar — helper for the Omarchy plugin
(crsstha.ytmusic). Plays YouTube Music without the app: ytmusicapi for search,
browsing and radio, mpv + yt-dlp for the audio.

  ytm-bar daemon          Run the player service (systemd: ytm-bar.service).
                          It owns mpv and the queue, and serves the commands
                          below on 127.0.0.1.
  ytm-bar start           Start the service, unless it's running.
  ytm-bar signin          Connect your YouTube Music account (likes, library,
                          personal home): sign in to Google in a browser window.
  ytm-bar login           The same, by pasting request headers from your browser.
  ytm-bar logout          Forget the account.
  ytm-bar account         Whether you're logged in, and as whom.
  ytm-bar song            The current song, as JSON.
  ytm-bar state           Like / shuffle / repeat / volume and the queue, as JSON.
  ytm-bar queue           The queue only, as JSON.
  ytm-bar toggle | next | previous | like | dislike | shuffle | repeat
  ytm-bar seek SECONDS    Jump to a position in the current song.
  ytm-bar volume PERCENT  Set the volume (0-100, or 0-150 with boost).
  ytm-bar mute | boost    Toggle mute / volume boost (up to 150%).
  ytm-bar eq PRESET       flat, bass, vocal, treble, loudness or night.
  ytm-bar sleep MINUTES|end|off
                          Pause after MINUTES of playing, or when this song ends.
  ytm-bar remove INDEX | playnext INDEX | move FROM TO
                          Edit the queue (INDEX as in "ytm-bar queue").
  ytm-bar jump INDEX      Play the queue item at INDEX.
  ytm-bar search QUERY [--filter all|songs|videos|albums|artists|playlists]
  ytm-bar home            Your YouTube Music home page, as sections.
  ytm-bar library         Your playlists, albums and artists (needs login).
  ytm-bar open TYPE ID    An album, artist or playlist, as sections.
  ytm-bar play VIDEO_ID   Play a song now, followed by its radio.
  ytm-bar add VIDEO_ID    Queue a song to play next.
  ytm-bar playall TYPE ID [INDEX]
                          Replace the queue with an album, playlist or an
                          artist's songs, starting at INDEX.

Every command except daemon prints one JSON object with "ok", plus "error"
and "code" ("offline", "unauthorized", "failed") when it didn't work.
The live now-playing display polls GET /song directly from Panel.qml.
"""

import json
import os
import random
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import traceback
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = int(os.environ.get("YTM_BAR_PORT", "26539"))
API = f"http://127.0.0.1:{PORT}"
# Every request must carry this header. A web page can't add it without a CORS
# preflight, which the service never answers, so browsers can't drive it.
HEADER = "X-Ytm-Bar"
CONFIG = Path.home() / ".config/ytm-bar"
AUTH_FILE = CONFIG / "browser.json"
# "Sign in with Google" opens a Chromium window with this profile, kept for
# ytm-bar alone, and reads the login from its cookies.
SIGNIN_PROFILE = CONFIG / "chromium"
SIGNIN_URL = ("https://accounts.google.com/ServiceLogin?service=youtube&continue="
              "https%3A%2F%2Fwww.youtube.com%2Fsignin%3Faction_handle_signin%3Dtrue%26next%3D"
              "https%253A%252F%252Fmusic.youtube.com%252F")
SIGNIN_BROWSERS = ("chromium", "google-chrome-stable", "brave")
STATE_FILE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "ytm-bar/state.json"
MPV_SOCKET = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "ytm-bar-mpv.sock"
SERVICE = "ytm-bar.service"
WATCH_URL = "https://music.youtube.com/watch?v="
QUEUE_LIMIT = 10
RADIO_LIMIT = 25
RADIO_AHEAD = 3  # fetch more radio when this few songs are left
COLLECTION_LIMIT = 100
HOME_TTL = 600  # seconds the home page is cached
REPEAT_MODES = ["NONE", "ALL", "ONE"]
LIKE_STATES = ("LIKE", "DISLIKE", "INDIFFERENT")
COLLECTIONS = ("album", "artist", "playlist")

# Search filters: (section title, entry type, results in "all", results when filtered).
FILTERS = {
    "songs": ("Songs", "song", 6, 20),
    "videos": ("Videos", "video", 3, 20),
    "albums": ("Albums", "album", 4, 20),
    "artists": ("Artists", "artist", 3, 20),
    "playlists": ("Playlists", "playlist", 3, 20),
}

USAGE = {
    "seek": "Usage: ytm-bar seek NUMBER",
    "volume": "Usage: ytm-bar volume NUMBER",
    "jump": "Usage: ytm-bar jump NUMBER",
    "search": "Usage: ytm-bar search QUERY [--filter all|songs|videos|albums|artists|playlists]",
    "play": "Usage: ytm-bar play VIDEO_ID",
    "add": "Usage: ytm-bar add VIDEO_ID",
    "open": "Usage: ytm-bar open album|artist|playlist ID",
    "playall": "Usage: ytm-bar playall album|artist|playlist ID [INDEX]",
    "sleep": "Usage: ytm-bar sleep MINUTES|end|off",
    "eq": "Usage: ytm-bar eq flat|bass|vocal|treble|loudness|night",
    "remove": "Usage: ytm-bar remove INDEX",
    "playnext": "Usage: ytm-bar playnext INDEX",
    "move": "Usage: ytm-bar move FROM TO",
}
COMMANDS = {"song", "state", "queue", "toggle", "next", "previous", "like", "dislike",
            "shuffle", "repeat", "home", "library", "account", "login", "signin", "logout",
            "mute", "boost", *USAGE}

# Equalizer presets: gains in dB for five bands, as in the design.
EQ_BANDS = (60, 230, 910, 3600, 14000)
EQ_PRESETS = {
    "flat": (0, 0, 0, 0, 0),
    "bass": (5, 4, 1, 0, 0),
    "vocal": (-1, 0, 4, 3, 0),
    "treble": (0, 0, 1, 4, 5),
    "loudness": (5, 2, 0, 2, 5),
    "night": (-1, 0, 2, 1, -1),
}
BOOST_MAX = 150  # volume % allowed with boost on


def eq_filter(name):
    """mpv's audio filter for a preset: one peaking filter per band, after
    lowering the level by the biggest boost so loud songs don't clip."""
    gains = EQ_PRESETS[name]
    if not any(gains):
        return ""
    bands = [f"equalizer=f={f}:t=o:w=1.5:g={g}" for f, g in zip(EQ_BANDS, gains) if g]
    return "lavfi=[" + ",".join([f"volume={-max(0, *gains)}dB"] + bands) + "]"


class ApiError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


# ---- Turning ytmusicapi's results into the rows the panel shows.

def artists_of(item):
    return ", ".join(a["name"] for a in item.get("artists") or [] if a.get("name"))


def clock(seconds):
    seconds = int(seconds or 0)
    return f"{seconds // 60}:{seconds % 60:02d}"


def seconds_of(text):
    """"3:05" or "1:02:03" -> seconds; 0 when there's no length."""
    total = 0
    for part in (text or "").split(":"):
        if not part.isdigit():
            return 0
        total = total * 60 + int(part)
    return total


def image_of(item, size=544):
    """The largest thumbnail. Album art URLs carry their size (=w60-h60), so ask
    for a bigger square instead."""
    thumbs = item.get("thumbnails") or item.get("thumbnail") or []
    if not thumbs:
        return ""
    url = max(thumbs, key=lambda t: t.get("width") or 0).get("url", "")
    return re.sub(r"=w\d+-h\d+", f"=w{size}-h{size}", url)


def joined(*parts):
    return " · ".join(p for p in parts if p)


def track_of(item):
    """A song from search, radio, an album or a playlist, reduced to what the
    player needs."""
    length = item.get("duration") or item.get("length") or ""
    duration = item.get("duration_seconds") or seconds_of(length)
    album = item.get("album")
    return {
        "videoId": item["videoId"],
        "title": item.get("title") or "",
        "artist": artists_of(item),
        "album": album if isinstance(album, str) else (album or {}).get("name") or "",
        "length": length or (clock(duration) if duration else ""),
        "duration": duration,
        "image": image_of(item),
        "like": item.get("likeStatus") if item.get("likeStatus") in LIKE_STATES else None,
    }


def entry_of(item):
    """Any ytmusicapi item (song, video, album, artist, playlist) as a panel row:
    {type, id, title, subtitle, length, image}. None for things the player
    can't use (episodes, podcasts, profiles, unavailable songs)."""
    kind = item.get("resultType")
    browse = item.get("browseId") or ""
    if kind in ("episode", "podcast", "profile", "station"):
        return None
    if item.get("videoId") and kind in (None, "song", "video"):
        if item.get("isAvailable") is False:
            return None
        is_video = kind == "video"
        track = track_of(item)
        views = item.get("views") + " views" if is_video and item.get("views") else ""
        # Some search results come without their artist; say what it is instead.
        artist = track["artist"] or ("Video" if is_video else "Song")
        return {"type": "video" if is_video else "song", "id": item["videoId"],
                "title": track["title"], "subtitle": joined(artist, views),
                "length": track["length"], "image": image_of(item, 120)}
    if browse.startswith("MPRE"):
        year = item.get("year") or ""
        return {"type": "album", "id": browse, "title": item.get("title") or "",
                "subtitle": joined(item.get("type") or "Album", artists_of(item), year if year.isdigit() else ""),
                "length": "", "image": image_of(item, 120)}
    if kind == "artist" or browse.startswith("UC"):
        artist = (item.get("artists") or [{}])[0]
        subscribers = item.get("subscribers")
        return {"type": "artist", "id": browse or artist.get("id") or "",
                "title": item.get("artist") or item.get("title") or artist.get("name") or "",
                "subtitle": joined("Artist", subscribers + " subscribers" if subscribers else ""),
                "length": "", "image": image_of(item, 120)}
    playlist = item.get("playlistId") or (browse[2:] if browse.startswith("VL") else "")
    if playlist:
        count = item.get("count") or item.get("itemCount")
        return {"type": "playlist", "id": playlist, "title": item.get("title") or "",
                "subtitle": joined("Playlist", item.get("author") if isinstance(item.get("author"), str)
                                   else artists_of(item), f"{count} songs" if count else ""),
                "length": "", "image": image_of(item, 120)}
    return None


def entries_of(items, limit=None, numbered=False):
    """Rows for a list of items: unusable ones and repeats dropped. Numbered rows
    carry their position, for playing an album or playlist from that song."""
    rows, seen = [], set()
    for item in items or []:
        row = entry_of(item)
        if row is None or not row["id"] or (row["type"], row["id"]) in seen:
            continue
        seen.add((row["type"], row["id"]))
        if numbered:
            row["index"] = len(rows)
        rows.append(row)
        if len(rows) == limit:
            break
    return rows


def search_sections(items, filter_name="all"):
    """Group search results like YouTube Music: the top result, then a section
    per type (or one section for a filtered search)."""
    if filter_name != "all":
        title, _, _, limit = FILTERS[filter_name]
        rows = entries_of(items, limit)
        return [{"title": title, "items": rows}] if rows else []
    sections = []
    top = [item for item in items or [] if item.get("category") == "Top result"][:1]
    top_rows = entries_of(top)
    if top_rows:
        sections.append({"title": "Top result", "items": top_rows})
    shown = {(row["type"], row["id"]) for row in top_rows}
    rows = [row for row in entries_of(items) if (row["type"], row["id"]) not in shown]
    for title, kind, limit, _ in FILTERS.values():
        of_kind = [row for row in rows if row["type"] == kind][:limit]
        if of_kind:
            sections.append({"title": title, "items": of_kind})
    return sections


def normalize_headers(text):
    """Request headers as "name: value" lines. Chromium's DevTools (without
    "Raw") shows each name on one line and its value on the next; HTTP/2
    pseudo-headers (:authority, :path, ...) aren't real headers, so drop them."""
    lines = [line.strip() for line in (text or "").splitlines() if line.strip()]
    named = sum(bool(re.match(r"^:?[\w-]+: ", line)) for line in lines)
    if named * 2 >= len(lines):
        pairs = [line.split(": ", 1) for line in lines if ": " in line]
    else:
        pairs = list(zip(lines[0::2], lines[1::2]))
    return "\n".join(f"{name}: {value}" for name, value in pairs if not name.startswith(":"))


def profile_headers(profile):
    """Request headers for YouTube Music made from the cookies in a Chromium
    profile, or None while it isn't signed in."""
    from yt_dlp.cookies import extract_cookies_from_browser
    if not any(Path(profile).glob("*/**/Cookies")):
        return None  # Chromium hasn't saved any cookies yet
    # --password-store=basic (see Player.signin) encrypts with a fixed key, so
    # no keyring is needed to read them back.
    jar = extract_cookies_from_browser("chromium", profile=str(profile), keyring="BASICTEXT")
    cookies = {c.name: c.value for c in jar if (c.domain or "").endswith("youtube.com")}
    if not cookies.get("__Secure-3PAPISID"):
        return None
    from ytmusicapi.helpers import get_authorization
    origin = "https://music.youtube.com"
    # ytmusicapi only treats a login as cookies (not OAuth) with an
    # authorization header; it signs each request afresh anyway.
    return "\n".join([
        "cookie: " + "; ".join(f"{k}={v}" for k, v in cookies.items()),
        "x-goog-authuser: 0",
        f"origin: {origin}",
        "authorization: " + get_authorization(cookies["__Secure-3PAPISID"] + " " + origin),
    ])


def video_id_of(url):
    match = re.search(r"[?&]v=([\w-]{11})", url or "")
    return match.group(1) if match else None


# ---- The service: mpv over its JSON IPC socket.

class Mpv:
    """One mpv process with no video, driven through --input-ipc-server.
    mpv-mpris (if installed) gives it media keys and an MPRIS player."""

    def __init__(self, volume, on_event):
        self.on_event = on_event
        self.lock = threading.Lock()
        self.waiting = {}
        self.next_id = 0
        MPV_SOCKET.unlink(missing_ok=True)
        self.proc = subprocess.Popen([
            "mpv", "--idle=yes", "--no-video", "--no-terminal", "--audio-display=no",
            f"--input-ipc-server={MPV_SOCKET}", "--ytdl-format=bestaudio/best",
            "--prefetch-playlist=yes", f"--volume={volume}", f"--volume-max={BOOST_MAX}",
        ], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + 10
        while True:
            try:
                self.sock = socket.socket(socket.AF_UNIX)
                self.sock.connect(str(MPV_SOCKET))
                break
            except OSError:
                self.sock.close()
                if self.proc.poll() is not None or time.monotonic() > deadline:
                    raise ApiError("failed", "mpv didn't start")
                time.sleep(0.05)
        threading.Thread(target=self.read, daemon=True).start()

    @property
    def alive(self):
        return self.proc.poll() is None

    def read(self):
        buffer = b""
        while True:
            try:
                chunk = self.sock.recv(65536)
            except OSError:
                chunk = b""
            if not chunk:
                break
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                try:
                    message = json.loads(line)
                except ValueError:
                    continue
                if "request_id" in message:
                    slot = self.waiting.get(message["request_id"])
                    if slot:
                        slot.append(message)
                        slot[0].set()
                elif "event" in message:
                    # Never block the reader: handlers send commands of their own.
                    threading.Thread(target=self.on_event, args=(message,), daemon=True).start()
        for slot in list(self.waiting.values()):
            slot[0].set()

    def command(self, *args):
        with self.lock:
            self.next_id += 1
            request_id = self.next_id
            slot = [threading.Event()]
            self.waiting[request_id] = slot
            try:
                self.sock.sendall(json.dumps({"command": list(args), "request_id": request_id}).encode() + b"\n")
            except OSError:
                del self.waiting[request_id]
                raise ApiError("failed", "mpv stopped")
        slot[0].wait(5)
        self.waiting.pop(request_id, None)
        if len(slot) < 2:
            raise ApiError("failed", "mpv didn't answer")
        reply = slot[1]
        if reply.get("error") not in ("success", "property unavailable"):
            raise ApiError("failed", f"mpv: {reply.get('error')}")
        return reply.get("data")

    def get(self, name, default=None):
        value = self.command("get_property", name)
        return default if value is None else value

    def set(self, name, value):
        self.command("set_property", name, value)

    def quit(self):
        try:
            self.command("quit")
        except ApiError:
            pass
        self.proc.terminate()


class Player:
    def __init__(self):
        self.lock = threading.RLock()
        self.mpv = None
        self.tracks = {}  # videoId -> track_of(...)
        self.collections = {}  # (type, id) -> [track, ...] for playall
        self.radio_seeds = set()
        self.shuffle = False
        self.repeat = "NONE"
        self.volume = 70
        self.eq = "flat"
        self.boost = False
        self.muted = False
        # Sleep timer: {"mode": "min", "left": seconds, "minutes": n} counts down
        # while playing; {"mode": "end"} pauses when the current song ends.
        self.sleep = None
        self._yt = None
        self._yt_auth = None
        self._home = (0, None, None)  # (time, auth, sections)
        self._account = (None, None)  # (auth, info)
        self._signin = None  # the sign-in window's process, while it's watched
        self.signin_error = ""
        try:
            saved = json.loads(STATE_FILE.read_text())
            self.volume = int(saved.get("volume", self.volume))
            self.eq = saved.get("eq") if saved.get("eq") in EQ_PRESETS else self.eq
            self.boost = bool(saved.get("boost", False))
        except (OSError, ValueError, AttributeError):
            pass
        self.volume = min(self.volume, self.max_volume)

    @property
    def max_volume(self):
        return BOOST_MAX if self.boost else 100

    def save(self):
        try:
            STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
            STATE_FILE.write_text(json.dumps({"volume": self.volume, "eq": self.eq, "boost": self.boost}))
        except OSError:
            pass

    # -- ytmusicapi, signed in when login saved headers.

    @property
    def logged_in(self):
        return AUTH_FILE.exists()

    def auth_stamp(self):
        return AUTH_FILE.stat().st_mtime if self.logged_in else None

    def yt(self):
        auth = self.auth_stamp()
        if self._yt is None or auth != self._yt_auth:
            try:
                from ytmusicapi import YTMusic
            except ImportError:
                raise ApiError("failed", "ytmusicapi isn't installed — run: omarchy pkg add python-ytmusicapi")
            try:
                self._yt = YTMusic(str(AUTH_FILE)) if auth else YTMusic()
            except Exception as e:
                raise ApiError("unauthorized", f"Couldn't read the login — log in again ({e})")
            self._yt_auth = auth
        return self._yt

    def call(self, name, *args, **kwargs):
        try:
            return getattr(self.yt(), name)(*args, **kwargs)
        except ApiError:
            raise
        except Exception as e:
            raise ApiError("failed", f"YouTube Music: {e}")

    def remember(self, items, image=""):
        """Keep track details for songs we may queue, so the panel can show them."""
        tracks = []
        for item in items or []:
            if item.get("videoId") and item.get("isAvailable") is not False:
                track = track_of(item)
                track["image"] = track["image"] or image
                known = self.tracks.setdefault(track["videoId"], track)
                known.update({k: v for k, v in track.items() if v})
                tracks.append(known)
        return tracks

    # -- mpv, started on first use.

    def player(self, start=True):
        with self.lock:
            if self.mpv and not self.mpv.alive:
                self.mpv = None
            if self.mpv is None and start:
                self.mpv = Mpv(self.volume, self.on_event)
                self.mpv.command("observe_property", 1, "playlist-pos")
                self.apply_repeat()
                self.mpv.set("af", eq_filter(self.eq))
                self.mpv.set("mute", self.muted)
            return self.mpv

    def on_event(self, message):
        """A new song: when the position changes, and again once it has loaded.
        The position event can arrive before mpv's playlist is updated (and
        doesn't fire when "play" replaces song 0 with another song 0), so
        file-loaded makes sure the radio check always runs."""
        event = message.get("event")
        try:
            if event == "property-change" and message.get("name") == "playlist-pos":
                self.song_changed(message.get("data"))
            elif event == "file-loaded" and self.mpv:
                self.song_changed(self.mpv.get("playlist-pos", -1))
            elif event == "end-file" and message.get("reason") == "eof" and self.sleep and self.sleep["mode"] == "end":
                # Sleep timer "end of song": the next song loads paused.
                self.sleep = None
                self.mpv.set("pause", True)
        except Exception:  # runs in its own thread: log it (journalctl --user -u ytm-bar)
            traceback.print_exc()

    def playlist(self):
        mpv = self.player(start=False)
        return (mpv.get("playlist", []) if mpv else []), mpv

    def current_index(self, playlist):
        return next((i for i, item in enumerate(playlist) if item.get("current")), -1)

    def song_changed(self, position):
        try:
            playlist, _ = self.playlist()
            if position is None or position < 0 or position >= len(playlist):
                return
            video_id = video_id_of(playlist[position].get("filename"))
            if len(playlist) - position <= RADIO_AHEAD and video_id:
                self.extend_radio(video_id, playlist)
            track = self.tracks.get(video_id)
            if video_id and self.logged_in and (track is None or track["like"] is None):
                self.fetch_track(video_id)
        except ApiError:
            pass

    def extend_radio(self, video_id, playlist):
        """Like YouTube Music's autoplay: when the queue runs low, append the
        radio for the current song."""
        with self.lock:
            if video_id in self.radio_seeds or self.repeat != "NONE":
                return
            self.radio_seeds.add(video_id)
        try:
            radio = self.call("get_watch_playlist", videoId=video_id, limit=RADIO_LIMIT)
        except ApiError:
            self.radio_seeds.discard(video_id)  # try again next time
            raise
        queued = {video_id_of(item.get("filename")) for item in playlist}
        for track in self.remember(radio.get("tracks")):
            if track["videoId"] not in queued:
                queued.add(track["videoId"])
                self.player().command("loadfile", WATCH_URL + track["videoId"], "append")

    def fetch_track(self, video_id):
        """Details (and the like state) for a song that didn't come from search or radio."""
        tracks = self.call("get_watch_playlist", videoId=video_id, limit=1).get("tracks") or []
        for item in tracks:
            if item.get("videoId") == video_id:
                track = track_of(item)
                track["like"] = track["like"] or "INDIFFERENT"
                self.tracks[video_id] = {**self.tracks.get(video_id, {}), **{k: v for k, v in track.items() if v}}

    # -- What the panel reads.

    def current(self):
        playlist, mpv = self.playlist()
        index = self.current_index(playlist)
        if index < 0 or mpv.get("idle-active", False):
            return None, mpv
        item = playlist[index]
        video_id = video_id_of(item.get("filename"))
        track = self.tracks.get(video_id) or {
            "videoId": video_id, "title": item.get("title") or mpv.get("media-title", ""),
            "artist": "", "album": "", "length": "", "duration": 0, "image": "", "like": None}
        return track, mpv

    def song(self, args):
        track, mpv = self.current()
        if track is None:
            return None
        return {
            "videoId": track["videoId"],
            "title": track["title"],
            "artist": track["artist"],
            "album": track["album"],
            "imageSrc": track["image"],
            "songDuration": mpv.get("duration", 0) or track["duration"],
            "elapsedSeconds": mpv.get("time-pos", 0),
            "isPaused": mpv.get("pause", False),
        }

    def queue(self, args):
        playlist, _ = self.playlist()
        start = max(0, self.current_index(playlist))
        rows = []
        for index, item in enumerate(playlist[start:start + QUEUE_LIMIT + 1], start):
            track = self.tracks.get(video_id_of(item.get("filename"))) or {}
            rows.append({
                "index": index,
                "title": track.get("title") or item.get("title") or item.get("filename"),
                "artist": track.get("artist", ""),
                "length": track.get("length", ""),
                "image": re.sub(r"=w544-h544", "=w120-h120", track.get("image", "")),
                "current": bool(item.get("current")),
            })
        return {"queue": rows, "queueCount": len(playlist) - start if playlist else 0}

    def state(self, args):
        track, mpv = self.current()
        sleep = self.sleep
        return {
            "like": (track or {}).get("like") or "INDIFFERENT",
            "shuffle": self.shuffle,
            "repeat": self.repeat,
            "volume": self.volume,
            "maxVolume": self.max_volume,
            "boost": self.boost,
            "eq": self.eq,
            "sleep": dict(sleep) if sleep else None,
            "muted": self.muted,
            "loggedIn": self.logged_in,
            "signingIn": self.signing_in,
            "signinError": self.signin_error,
            **self.queue(args),
        }

    # -- Browsing.

    def search(self, args):
        query, filter_name = args[0], (args[1] if len(args) > 1 else "all")
        if filter_name != "all" and filter_name not in FILTERS:
            raise ApiError("failed", USAGE["search"])
        if filter_name == "all":
            items = self.call("search", query)
        else:
            items = self.call("search", query, filter=filter_name, limit=FILTERS[filter_name][3])
        self.remember(items)
        return {"sections": search_sections(items, filter_name)}

    def home(self, args):
        stamp = self.auth_stamp()
        cached_at, cached_auth, sections = self._home
        if sections is None or cached_auth != stamp or time.monotonic() - cached_at > HOME_TTL:
            sections = []
            for shelf in self.call("get_home", limit=6):
                self.remember(shelf.get("contents"))
                rows = entries_of(shelf.get("contents"), 6)
                if rows:
                    sections.append({"title": shelf.get("title") or "", "items": rows})
            self._home = (time.monotonic(), stamp, sections)
        return {"sections": sections}

    def library(self, args):
        if not self.logged_in:
            raise ApiError("unauthorized", "Log in (Settings) to see your library")
        with ThreadPoolExecutor(3) as pool:
            playlists = pool.submit(self.call, "get_library_playlists", limit=25)
            albums = pool.submit(self.call, "get_library_albums", limit=25)
            artists = pool.submit(self.call, "get_library_subscriptions", limit=25)
            shelves = [("Playlists", playlists.result()), ("Albums", albums.result()),
                       ("Artists", artists.result())]
        sections = [{"title": title, "items": rows} for title, items in shelves if (rows := entries_of(items))]
        # Liked Music (playlist "LM") isn't always among the library playlists; put it first.
        liked = {"type": "playlist", "id": "LM", "title": "Liked Music", "subtitle": "Playlist · Your likes",
                 "length": "", "image": ""}
        if not sections or sections[0]["title"] != "Playlists":
            sections.insert(0, {"title": "Playlists", "items": []})
        playlists = sections[0]["items"]
        sections[0]["items"] = [liked] + [row for row in playlists if row["id"] != "LM"]
        return {"sections": sections}

    def open(self, args):
        """An album, artist or playlist page: a header and its sections. The
        songs are kept for playall."""
        kind, item_id = args[0], args[1]
        if kind == "album":
            album = self.call("get_album", item_id)
            image = image_of(album)
            self.collections[kind, item_id] = self.remember(album.get("tracks"), image)
            rows = entries_of(album.get("tracks"), numbered=True)
            for row in rows:
                row["image"] = row["image"] or image_of(album, 120)
            count = album.get("trackCount")
            return {"type": kind, "id": item_id, "title": album.get("title") or "", "image": image,
                    "subtitle": joined(album.get("type") or "Album", artists_of(album), album.get("year") or "",
                                       f"{count} songs" if count else ""),
                    "sections": [{"title": "Songs", "items": rows}]}
        if kind == "playlist":
            playlist = self.call("get_playlist", item_id, limit=COLLECTION_LIMIT)
            self.collections[kind, item_id] = self.remember(playlist.get("tracks"))
            author = playlist.get("author")
            count = playlist.get("trackCount")
            return {"type": kind, "id": item_id, "title": playlist.get("title") or "",
                    "image": image_of(playlist),
                    "subtitle": joined("Playlist", (author or {}).get("name") if isinstance(author, dict) else author,
                                       f"{count} songs" if count else ""),
                    "sections": [{"title": "Songs", "items": entries_of(playlist.get("tracks"), numbered=True)}]}
        if kind == "artist":
            artist = self.call("get_artist", item_id)
            songs = (artist.get("songs") or {}).get("results") or []
            self.collections[kind, item_id] = self.remember(songs)
            sections = [{"title": "Top songs", "items": entries_of(songs, numbered=True)}]
            for key, title in (("albums", "Albums"), ("singles", "Singles & EPs")):
                rows = entries_of((artist.get(key) or {}).get("results"))
                for row in rows:
                    row["subtitle"] = row["subtitle"].replace(" · " + (artist.get("name") or "-"), "")
                if rows:
                    sections.append({"title": title, "items": rows})
            subscribers = artist.get("subscribers")
            return {"type": kind, "id": item_id, "title": artist.get("name") or "", "image": image_of(artist),
                    "subtitle": joined("Artist", subscribers + " subscribers" if subscribers else ""),
                    "sections": [s for s in sections if s["items"]]}
        raise ApiError("failed", USAGE["open"])

    def playall(self, args):
        kind, item_id = args[0], args[1]
        start = int(float(args[2])) if len(args) > 2 else 0
        if (kind, item_id) not in self.collections:
            self.open([kind, item_id])
        tracks = self.collections.get((kind, item_id)) or []
        if not tracks:
            raise ApiError("failed", "Nothing to play here")
        start = min(max(0, start), len(tracks) - 1)
        mpv = self.player()
        with self.lock:
            mpv.command("stop")  # also clears the playlist
            for track in tracks:
                mpv.command("loadfile", WATCH_URL + track["videoId"], "append")
            mpv.command("playlist-play-index", start)
            mpv.set("pause", False)
            if self.shuffle:
                self.shuffle = False
                self.shuffle_(args)

    # -- The account.

    def account(self, args):
        stamp = self.auth_stamp()
        if stamp is None:
            return {"loggedIn": False, "name": "", "photo": ""}
        cached_auth, info = self._account
        if info is None or cached_auth != stamp:
            try:
                info = self.call("get_account_info")
            except ApiError as e:
                # YouTube answers saved cookies it has revoked (after a sign-out in
                # the browser they came from) as a guest, without an account header.
                if "activeAccountHeaderRenderer" not in str(e):
                    raise
                AUTH_FILE.replace(AUTH_FILE.with_suffix(".expired"))
                self._account = (None, None)
                # The sign-in window's profile may hold newer cookies.
                if not self.signing_in and self.login_from_profile():
                    return self.account(args)
                return {"loggedIn": False, "name": "", "photo": "", "expired": True}
            self._account = (stamp, info)
        return {"loggedIn": True, "name": info.get("accountName") or "",
                "handle": info.get("channelHandle") or "", "photo": info.get("accountPhotoUrl") or ""}

    def login(self, args):
        """Save request headers copied from a signed-in music.youtube.com tab,
        after checking that they work."""
        headers = normalize_headers(args[0] if args else "")
        if not headers:
            raise ApiError("failed", "Paste the request headers first")
        return self.save_login(headers)

    def save_login(self, headers):
        try:
            from ytmusicapi import YTMusic, setup
            auth = setup(headers_raw=headers)
            info = YTMusic(auth).get_account_info()
        except ImportError:
            raise ApiError("failed", "ytmusicapi isn't installed — run: omarchy pkg add python-ytmusicapi")
        except Exception as e:
            raise ApiError("unauthorized", f"Those headers didn't work: {e}")
        CONFIG.mkdir(parents=True, exist_ok=True)
        tmp = AUTH_FILE.with_suffix(".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(auth)
        tmp.replace(AUTH_FILE)
        return {"loggedIn": True, "name": info.get("accountName") or ""}

    def logout(self, args):
        AUTH_FILE.unlink(missing_ok=True)
        self._account = (None, None)
        # Forget the sign-in window's profile too, or it would log back in.
        subprocess.run(["rm", "-rf", "--", str(SIGNIN_PROFILE)], check=False)
        return {"loggedIn": False}

    @property
    def signing_in(self):
        return self._signin is not None

    def signin(self, args):
        """Open a browser window to sign in to Google. Once YouTube Music's
        cookies show up in its profile, they become the login and the window
        closes."""
        with self.lock:
            if self.signing_in:
                return {"signingIn": True}
            browser = next((b for b in SIGNIN_BROWSERS if shutil.which(b)), None)
            if not browser:
                raise ApiError("failed", "Signing in needs Chromium — run: omarchy pkg add chromium")
            SIGNIN_PROFILE.mkdir(parents=True, exist_ok=True, mode=0o700)
            self.signin_error = ""
            self._signin = subprocess.Popen([
                browser, f"--user-data-dir={SIGNIN_PROFILE}", "--password-store=basic",
                "--no-first-run", "--no-default-browser-check", f"--app={SIGNIN_URL}",
                "--class=ytm-bar-signin",
            ], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
            threading.Thread(target=self.watch_signin, args=(self._signin,), daemon=True).start()
        return {"signingIn": True}

    def watch_signin(self, proc):
        error, tried = "The window closed before you signed in", None
        while True:
            closed = proc.poll() is not None
            try:
                headers = profile_headers(SIGNIN_PROFILE)
                if headers and headers != tried:
                    tried = headers
                    self.save_login(headers)
                    error = ""
                    break
            except ApiError as e:
                error = str(e)
            except Exception as e:
                error = f"Couldn't read the sign-in window: {e}"
            if closed:
                break
            time.sleep(2)
        if proc.poll() is None:
            proc.terminate()  # signed in: close the window
        self.signin_error = error
        self._signin = None

    def login_from_profile(self):
        if not SIGNIN_PROFILE.exists():
            return False
        try:
            headers = profile_headers(SIGNIN_PROFILE)
            return bool(headers) and bool(self.save_login(headers))
        except Exception:
            return False

    # -- Controls.

    def toggle(self, args):
        if self.current()[0] is not None:
            self.mpv.command("cycle", "pause")

    def next(self, args):
        track, mpv = self.current()
        if track is None:
            return
        # On the last song, fetch its radio first so there's always a next one.
        playlist, _ = self.playlist()
        at = self.current_index(playlist)
        if at >= len(playlist) - 1 and self.repeat == "NONE":
            self.extend_radio(track["videoId"], playlist)
            if len(self.playlist()[0]) <= at + 1:
                raise ApiError("failed", "That's the end of the queue")
        mpv.command("playlist-next")

    def previous(self, args):
        """Back to the start of the song, or the previous one if it just began."""
        track, mpv = self.current()
        if track is None:
            return
        if mpv.get("time-pos", 0) > 3 or mpv.get("playlist-pos", 0) == 0:
            mpv.command("seek", 0, "absolute")
        else:
            mpv.command("playlist-prev")

    def rate(self, rating):
        track, _ = self.current()
        if track is None:
            return
        if not self.logged_in:
            raise ApiError("unauthorized", "Log in (Settings) to like songs")
        new = "INDIFFERENT" if track.get("like") == rating else rating
        self.call("rate_song", track["videoId"], new)
        track["like"] = new
        self.tracks[track["videoId"]] = track
        return new

    def like(self, args):
        self.rate("LIKE")

    def dislike(self, args):
        # Like YouTube Music: disliking a song skips it.
        if self.rate("DISLIKE") == "DISLIKE":
            self.next(args)

    def shuffle_(self, args):
        """Shuffle what's left of the queue (turning it off keeps the order)."""
        with self.lock:
            self.shuffle = not self.shuffle
            playlist, mpv = self.playlist()
            if not self.shuffle or not mpv:
                return
            start = self.current_index(playlist) + 1
            for target in range(start, len(playlist) - 1):
                source = random.randint(target, len(playlist) - 1)
                if source != target:
                    mpv.command("playlist-move", source, target)

    def apply_repeat(self):
        if self.mpv:
            self.mpv.set("loop-playlist", "inf" if self.repeat == "ALL" else "no")
            self.mpv.set("loop-file", "inf" if self.repeat == "ONE" else "no")

    def repeat_(self, args):
        with self.lock:
            self.repeat = REPEAT_MODES[(REPEAT_MODES.index(self.repeat) + 1) % len(REPEAT_MODES)]
            self.apply_repeat()

    def seek(self, args):
        if self.current()[0] is not None:
            self.mpv.command("seek", float(args[0]), "absolute")

    def volume_(self, args):
        self.volume = int(min(self.max_volume, max(0, float(args[0]))))
        self.muted = False
        mpv = self.player(start=False)
        if mpv:
            mpv.set("volume", self.volume)
            mpv.set("mute", False)
        self.save()

    def mute(self, args):
        self.muted = not self.muted
        mpv = self.player(start=False)
        if mpv:
            mpv.set("mute", self.muted)

    def boost_(self, args):
        """Allow volume above 100% (up to BOOST_MAX); turning it off caps it again."""
        self.boost = not self.boost
        if self.volume > self.max_volume:
            self.volume_([self.max_volume])
        self.save()

    def eq_(self, args):
        name = args[0].lower() if args else ""
        if name not in EQ_PRESETS:
            raise ApiError("failed", USAGE["eq"])
        self.eq = name
        mpv = self.player(start=False)
        if mpv:
            mpv.set("af", eq_filter(name))
        self.save()

    def sleep_(self, args):
        value = args[0].lower() if args else ""
        if value == "off":
            self.sleep = None
        elif value == "end":
            self.sleep = {"mode": "end"}
        else:
            try:
                minutes = int(float(value))
            except ValueError:
                raise ApiError("failed", USAGE["sleep"])
            if minutes <= 0:
                raise ApiError("failed", USAGE["sleep"])
            self.sleep = {"mode": "min", "left": minutes * 60, "minutes": minutes}

    def tick(self):
        """Once a second: run down a minutes sleep timer while music plays."""
        sleep = self.sleep
        if not sleep or sleep["mode"] != "min":
            return
        track, mpv = self.current()
        if track is None or mpv.get("pause", False):
            return
        sleep["left"] -= 1
        if sleep["left"] <= 0:
            self.sleep = None
            mpv.set("pause", True)

    # -- Editing the queue (indexes are mpv playlist positions).

    def queue_index(self, value):
        playlist, mpv = self.playlist()
        index = int(float(value))
        if not mpv or not 0 <= index < len(playlist):
            raise ApiError("failed", "That song isn't in the queue any more")
        return index, self.current_index(playlist), mpv

    def remove(self, args):
        index, current, mpv = self.queue_index(args[0])
        if index == current:
            raise ApiError("failed", "That's the song playing now")
        mpv.command("playlist-remove", index)

    def playnext(self, args):
        index, current, mpv = self.queue_index(args[0])
        if index > current + 1:
            mpv.command("playlist-move", index, current + 1)

    def move(self, args):
        """Move a queued song to another place after the current one (drag and drop)."""
        index, current, mpv = self.queue_index(args[0])
        target = int(float(args[1]))
        if index <= current or target <= current or index == target:
            return
        # mpv inserts before the item at the target; moving down means one further.
        mpv.command("playlist-move", index, target + 1 if target > index else target)

    def jump(self, args):
        playlist, mpv = self.playlist()
        index = int(float(args[0]))
        if mpv and 0 <= index < len(playlist):
            mpv.command("playlist-play-index", index)
            mpv.set("pause", False)

    def play(self, args):
        """Start a fresh queue with this song; its radio follows."""
        video_id = args[0]
        mpv = self.player()
        with self.lock:
            self.radio_seeds.discard(video_id)
        mpv.command("loadfile", WATCH_URL + video_id, "replace")
        mpv.set("pause", False)

    def add(self, args):
        """Play next — or now, if nothing is playing."""
        mpv = self.player()
        idle = self.current()[0] is None
        mpv.command("loadfile", WATCH_URL + args[0], "append-play" if idle else "insert-next")

    def run(self, command, args):
        handler = getattr(self, command + "_", None) or getattr(self, command, None)
        if command not in COMMANDS or handler is None:
            raise ApiError("failed", f"Unknown command {command!r}")
        if command in ("open", "playall") and (len(args) < 2 or args[0] not in COLLECTIONS):
            raise ApiError("failed", USAGE[command])
        return handler(args)


def serve():
    player = Player()

    class Handler(BaseHTTPRequestHandler):
        def reply(self, status, body=None):
            data = json.dumps(body).encode() if body is not None else b""
            self.send_response(status)
            if data:
                self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def allowed(self):
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
            if self.headers.get(HEADER) is None or host not in ("127.0.0.1", "localhost"):
                self.reply(403, {"ok": False, "code": "failed", "error": "Forbidden"})
                return False
            return True

        def do_GET(self):
            # Panel.qml's poll: 200 with the song, 204 when nothing is loaded.
            if not self.allowed():
                return
            if urllib.parse.urlsplit(self.path).path != "/song":
                return self.reply(404, {"ok": False, "code": "failed", "error": "Not found"})
            try:
                song = player.song([])
            except ApiError as e:
                return self.reply(500, {"ok": False, "code": e.code, "error": str(e)})
            self.reply(200, song) if song else self.reply(204)

        def do_POST(self):
            if not self.allowed():
                return
            try:
                length = int(self.headers.get("Content-Length") or 0)
                args = json.loads(self.rfile.read(length) or b"{}").get("args") or []
                command = self.path.strip("/")
                result = player.run(command, [str(a) for a in args])
                if command == "song":
                    result = {"song": result}
                body = {"ok": True, **(result or {})}
            except ApiError as e:
                body = {"ok": False, "code": e.code, "error": str(e)}
            except (ValueError, IndexError) as e:
                body = {"ok": False, "code": "failed", "error": f"Bad request: {e}"}
            self.reply(200, body)

        def log_message(self, *args):
            pass

    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.daemon_threads = True

    def ticker():
        while True:
            time.sleep(1)
            try:
                player.tick()
            except Exception:
                traceback.print_exc()
    threading.Thread(target=ticker, daemon=True).start()
    # Stopping the service (SIGTERM) also stops mpv.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        server.serve_forever()
    finally:
        if player.mpv:
            player.mpv.quit()


# ---- The command line: a thin client of the service.

def request(method, path, body=None, timeout=5):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(API + path, data=data, method=method, headers={HEADER: "1"})
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as e:
        raise ApiError("failed", f"ytm-bar service returned HTTP {e.code}")
    except (urllib.error.URLError, ConnectionError, TimeoutError):
        raise ApiError("offline", "The ytm-bar service isn't running — run ytm-bar start")


def running():
    try:
        request("GET", "/song", timeout=1)
        return True
    except ApiError as e:
        return e.code != "offline"


def start():
    if running():
        return {}
    started = subprocess.run(["systemctl", "--user", "start", SERVICE], capture_output=True).returncode == 0
    if not started:  # not installed as a unit: run it detached instead
        subprocess.Popen([os.path.realpath(sys.argv[0]), "daemon"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + 10
    while not running():
        if time.monotonic() > deadline:
            raise ApiError("failed", "The ytm-bar service didn't start — see journalctl --user -u ytm-bar")
        time.sleep(0.1)
    return {}


def read_headers():
    if sys.stdin.isatty():
        print("Connect ytm-bar to your YouTube Music account:\n"
              "  1. Open https://music.youtube.com in your browser, signed in.\n"
              "  2. Open the developer tools (F12) → Network, and reload the page.\n"
              "  3. Find a POST request to \"browse\", right-click → Copy → Copy request headers.\n"
              "  4. Paste them below, then press Enter and Ctrl+D.\n", file=sys.stderr)
    return sys.stdin.read()


def number(args, name):
    try:
        return float(args[0])
    except (IndexError, ValueError):
        raise ApiError("failed", USAGE[name])


def run(command, args):
    if command == "start":
        return start()
    if command not in COMMANDS:
        raise ApiError("failed", f"Unknown command {command!r} — see ytm-bar --help")
    if command in ("seek", "volume", "jump", "remove", "playnext"):
        args = [str(number(args, command))]
    elif command == "move":
        if len(args) < 2:
            raise ApiError("failed", USAGE["move"])
        args = [str(number(args, "move")), str(number(args[1:], "move"))]
    elif command == "sleep" and not (args and (args[0] in ("end", "off") or args[0].replace(".", "", 1).isdigit())):
        raise ApiError("failed", USAGE["sleep"])
    elif command == "eq" and not (args and args[0].lower() in EQ_PRESETS):
        raise ApiError("failed", USAGE["eq"])
    elif command == "search":
        filter_name = "all"
        if "--filter" in args:
            at = args.index("--filter")
            filter_name = args[at + 1] if at + 1 < len(args) else ""
            args = args[:at] + args[at + 2:]
        query = " ".join(args).strip()
        if not query or (filter_name != "all" and filter_name not in FILTERS):
            raise ApiError("failed", USAGE["search"])
        args = [query, filter_name]
    elif command in ("play", "add") and not (args and args[0]):
        raise ApiError("failed", USAGE[command])
    elif command in ("open", "playall") and (len(args) < 2 or args[0] not in COLLECTIONS):
        raise ApiError("failed", USAGE[command])
    elif command == "login":
        args = [read_headers()]
    slow = command in ("search", "home", "library", "open", "playall", "login", "account")
    if command == "signin":
        result = request("POST", "/signin", {"args": []}, timeout=10)
        if not result.get("ok"):
            raise ApiError(result.get("code", "failed"), result.get("error", "Failed"))
        print("Sign in to Google in the window that opened; it closes when you're done.", file=sys.stderr)
        while True:
            time.sleep(1)
            state = request("POST", "/state", {"args": []}, timeout=10)
            if not state.get("signingIn"):
                break
        if not state.get("loggedIn"):
            raise ApiError("unauthorized", state.get("signinError") or "Not signed in")
        return {"loggedIn": True}
    result = request("POST", "/" + command, {"args": args}, timeout=60 if slow else 10)
    if not result.get("ok"):
        raise ApiError(result.get("code", "failed"), result.get("error", "Failed"))
    result.pop("ok")
    return result


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if args[0] == "daemon":
        serve()
        return 0
    try:
        result = {"ok": True, **run(args[0], args[1:])}
    except ApiError as e:
        result = {"ok": False, "code": e.code, "error": str(e)}
    print(json.dumps(result))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
