# >>> ytm-bar >>>
# YouTube Music: Super+Alt+m opens the player in search (Mod4+Mod1 spelled out:
# with `set $mod Mod1`, $mod+Mod1 would collapse to plain Alt+m)
bindsym Mod4+Mod1+m exec --no-startup-id ~/.local/bin/ytm-panel search
# The popup places itself at the top right, under the bar
for_window [instance="^ytm-panel$"] floating enable, border none
# i3 doesn't start graphical-session.target, which the service is wanted by
exec --no-startup-id systemctl --user start ytm-bar.service
# <<< ytm-bar <<<
